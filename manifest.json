{
    "manifest_version": 3,
    "name": "RoFilter: Game Quality Enhancer",
    "version": "1.1",
    "author": "Apeira Studios",
    "description": "Hides Roblox games below your specified rating percentage and removes sponsored games.",
    "action": {
        "default_popup": "popup.html",
        "default_title": "Filter Settings"
    },
    "content_scripts": [
        {
            "matches": [
                "*://*.roblox.com/*"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_idle"
        }
    ],
    "permissions": [
        "storage"
    ]
}